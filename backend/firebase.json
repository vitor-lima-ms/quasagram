{
  "$schema": "https://raw.githubusercontent.com/firebase/firebase-tools/master/schema/firebase-config.json",
  "functions": [
    {
      "source": ".",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        ".dataconnect",
        "src/infra/database/firebaseSql/dataconnect"
      ],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "dataconnect": { "source": "src/infra/database/firebaseSql/dataconnect" },
  "firestore": { "edition": "enterprise" },
  "emulators": {
    "functions": { "port": 5001 },
    "dataconnect": {
      "port": 9399,
      "dataDir": "src/infra/database/firebaseSql/dataconnect/.dataconnect/pgliteData"
    },
    "firestore": { "port": 8080, "edition": "enterprise" },
    "ui": { "enabled": true, "port": 4000 }
  }
}
